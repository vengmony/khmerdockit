# ---- KhmerDocKit environment variables (example) ----
# Copy this file to `.env` and fill in real values for local dev.
# DO NOT commit a real `.env` — it is gitignored.

# === Core ===
KHMERDOC_LOG_LEVEL=INFO
KHMERDOC_OCR_BACKEND=mock          # mock | paddle | tesseract
KHMERDOC_OCR_LANG=en               # en | km | en+km
KHMERDOC_EXTRACTOR_BACKEND=rules    # rules | llm (planned)
KHMERDOC_DOCUMENT_TYPE_HINT=auto    # auto | receipt | invoice | quotation | bank_slip

# === API ===
KHMERDOC_API_HOST=0.0.0.0
KHMERDOC_API_PORT=8000
KHMERDOC_API_CORS_ORIGINS=http://localhost:3000
KHMERDOC_API_MAX_UPLOAD_MB=10
KHMERDOC_API_ALLOWED_MIME=image/jpeg,image/png,image/webp,application/pdf

# === LLM (optional, off by default) ===
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
KHMERDOC_LLM_ENABLED=false

# === Web (Next.js) ====
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
